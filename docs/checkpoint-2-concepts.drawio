  </diagram>
  <diagram id="cp2-page-4-recovery" name="4 · Recovery = Git revert">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="r_title" value="Recovery is a Git revert — not a kubectl fix" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="r_sub" value="Same control path as a real release. Git is the source of truth; the cluster follows." style="text;html=1;fontSize=13;fontStyle=2;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="960" height="22" as="geometry" />
        </mxCell>
        <mxCell id="r_spine" value="" style="rounded=0;fillColor=#b0b0b0;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="88" y="110" width="4" height="410" as="geometry" />
        </mxCell>
        <mxCell id="r_n1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#345a8a;fontColor=#ffffff;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="110" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r_b1" value="&lt;b&gt;Record known-good&lt;/b&gt;&lt;br&gt;KNOWN_GOOD_IMAGE = current @sha256  ·  Argo Synced + Healthy  ·  Pod 1/1 Ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=middle;spacingLeft=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="130" y="105" width="820" height="52" as="geometry" />
        </mxCell>
        <mxCell id="r_n2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#7a2e2b;fontColor=#ffffff;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="192" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r_b2" value="&lt;b&gt;Ship the failure&lt;/b&gt;&lt;br&gt;Config PR adds  patches: - path: checkpoint-2-startup-failure.yaml  → merge → Argo Synced, Deployment Degraded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;verticalAlign=middle;spacingLeft=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="130" y="187" width="820" height="52" as="geometry" />
        </mxCell>
        <mxCell id="r_n3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#333333;fontColor=#ffffff;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="274" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r_b3" value="&lt;b&gt;Diagnose (Tab 3)&lt;/b&gt;&lt;br&gt;Argo → Deployment → Pod → events → logs.  Do NOT touch the cluster with kubectl." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;verticalAlign=middle;spacingLeft=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="130" y="269" width="820" height="52" as="geometry" />
        </mxCell>
        <mxCell id="r_n4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d6b656;strokeColor=#a68b2f;fontColor=#ffffff;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="356" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r_b4" value="&lt;b&gt;Revert in Git&lt;/b&gt;&lt;br&gt;GitHub &quot;Revert&quot; on the config PR → merge the rollback PR → the failure patch is removed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;verticalAlign=middle;spacingLeft=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="130" y="351" width="820" height="52" as="geometry" />
        </mxCell>
        <mxCell id="r_n5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#5b8039;fontColor=#ffffff;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="480" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r_b5" value="&lt;b&gt;Reconciled&lt;/b&gt;&lt;br&gt;Argo restores KNOWN_GOOD_IMAGE → Synced + Healthy, 1/1 Ready.  Verify CURRENT_IMAGE == KNOWN_GOOD_IMAGE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=middle;spacingLeft=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="130" y="475" width="820" height="52" as="geometry" />
        </mxCell>
        <mxCell id="r_banner" value="Rollback is a normal, auditable Git action — the cluster never diverges from Git. (The readiness scenario recovers the same way.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="130" y="560" width="820" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
